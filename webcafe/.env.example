# Copy this file to .env and fill in your values. Never commit .env.

PORT=8000
# Your live website address (used for payment return links)
PUBLIC_URL=https://your-domain.com
# Password for /admin.html (orders list)
ADMIN_KEY=change-this-to-a-long-secret

# ---- Online payments: Safepay (https://getsafepay.com) ----
# Leave the keys empty to run in TEST mode (no real money).
SAFEPAY_ENV=sandbox            # sandbox while testing, production when live
SAFEPAY_API_KEY=               # "public key" / client key from the Safepay dashboard
SAFEPAY_SECRET_KEY=            # "secret key" used to verify payment signatures

# ---- WhatsApp alerts to the owner (CallMeBot, free) ----
# Setup: https://www.callmebot.com/blog/free-api-whatsapp-messages/
CALLMEBOT_PHONE=+923369241221
CALLMEBOT_APIKEY=

# ---- Email alerts (owner) + receipts (customer) ----
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, use an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=WebCafe <your-email@gmail.com>
ORDER_EMAIL_TO=your-email@gmail.com
